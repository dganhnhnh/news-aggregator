# Runs either FastAPI service used by the development compose stack. The
# default command is the read-only news-api; compose overrides it for the
# operator-only news-admin-api. Both depend on the same pyproject.toml, so this
# image currently installs the full dependency set (including crawl4ai).
# Build from the repo root: docker build -f deployments/Dockerfile.api -t news-radar-api .
FROM python:3.12-slim

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY backend ./backend

# The API also installs crawl4ai's large browser wheels.
ARG UV_HTTP_TIMEOUT=300
ARG UV_HTTP_RETRIES=5
ARG UV_CONCURRENT_DOWNLOADS=4
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_LINK_MODE=copy uv sync --frozen --no-dev

ENV API_HOST=0.0.0.0
ENV API_PORT=8000
ENV PYTHONUNBUFFERED=1
ENV FASTEMBED_CACHE_PATH=/models
RUN mkdir -p /models
EXPOSE 8000 8001

CMD ["uv", "run", "news-api"]
