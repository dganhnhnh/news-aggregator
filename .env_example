# Required only for the Tavily search command.
TAVILY_API_KEY=

# Runtime logging.
LOG_LEVEL=INFO

# PostgreSQL exposed by compose.yaml for host-side CLI jobs.
POSTGRES_DB=news_radar
POSTGRES_USER=news_radar
POSTGRES_PASSWORD=news_radar
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://news_radar:news_radar@localhost:5433/news_radar

# RSS/Atom pipeline/worker defaults (.tsv or .opml).
RSS_FEED_PATH=
# Legacy fallback for existing Google News TSV deployments.
GOOGLE_NEWS_TSV_PATH=
MAX_FEEDS=0
MAX_ARTICLES_PER_FEED=20
MAX_CONCURRENT_FEEDS=2
MAX_CONCURRENT_CRAWLS=2
CRAWL_BATCH_SIZE=10
RSS_FEED_OFFSET=0
MAX_RETRIES_PER_RUN=50
# Embed/classify/cluster worker chunking and online-match policy.
EMBED_BATCH_SIZE=32
CLASSIFY_BATCH_SIZE=50
CLUSTER_BATCH_SIZE=50
CLUSTER_WINDOW_HOURS=72
CLUSTER_CANDIDATE_LIMIT=20
CLUSTER_THRESHOLD=0.75
CLUSTER_MERGE_THRESHOLD=0.85
# Default --interval for the deprecated news-service alias.
SERVICE_INTERVAL_SECONDS=1800

# How long a run may go without a heartbeat before a later run reaps it.
# The effective threshold is max(3 * --interval, this value).
WORKER_HEARTBEAT_TIMEOUT_SECONDS=900

# FastAPI (news-api) settings.
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000
API_DEFAULT_WINDOW_DAYS=30
