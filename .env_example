# Required only for the Tavily search command.
TAVILY_API_KEY=

# Runtime logging.
LOG_LEVEL=INFO

# PostgreSQL exposed by compose.yaml for host-side CLI jobs.
POSTGRES_DB=news_radar
POSTGRES_USER=news_radar
POSTGRES_PASSWORD=news_radar
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://news_radar:news_radar@localhost:5433/news_radar

# RSS/Atom pipeline/service defaults (.tsv or .opml).
RSS_FEED_PATH=
# Legacy fallback for existing Google News TSV deployments.
GOOGLE_NEWS_TSV_PATH=
MAX_FEEDS=0
MAX_ARTICLES_PER_FEED=20
MAX_CONCURRENT_FEEDS=2
MAX_CONCURRENT_CRAWLS=2
CRAWL_BATCH_SIZE=10
RSS_FEED_OFFSET=0
MAX_RETRIES_PER_RUN=50
SERVICE_INTERVAL_SECONDS=1800
