# Required only for the Tavily search command.
TAVILY_API_KEY=

# Runtime logging.
LOG_LEVEL=INFO

# PostgreSQL exposed by compose.yaml for host-side CLI jobs.
POSTGRES_DB=news_radar
POSTGRES_USER=news_radar
POSTGRES_PASSWORD=news_radar
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://news_radar:news_radar@localhost:5433/news_radar

# RSS/Atom pipeline/worker defaults (.tsv or .opml).
RSS_FEED_PATH=
# Legacy fallback for existing Google News TSV deployments.
GOOGLE_NEWS_TSV_PATH=
MAX_FEEDS=0
MAX_ARTICLES_PER_FEED=20
MAX_CONCURRENT_FEEDS=8
MAX_CONCURRENT_CRAWLS=6
CRAWL_BATCH_SIZE=10
FEED_FETCH_TIMEOUT_SECONDS=8
# Adaptive RSS polling: strict tiers 5m / 30m / 6h. The legacy
# FEED_POLL_INTERVAL_SECONDS name is retained for the middle tier.
FEED_POLL_FAST_INTERVAL_SECONDS=300
FEED_POLL_INTERVAL_SECONDS=1800
FEED_POLL_SLOW_INTERVAL_SECONDS=21600
FEED_POLL_MIN_GAPS=3
FEED_POLL_TRIM_FRACTION=0.1
FEED_POLL_FUTURE_TOLERANCE_SECONDS=300
INSTANT_FEED_POLL_INTERVAL_SECONDS=30
RSS_FEED_OFFSET=0
MAX_RETRIES_PER_RUN=50
# Embed/classify/cluster worker chunking and online-match policy.
EMBED_BATCH_SIZE=32
CLASSIFY_BATCH_SIZE=50
CLUSTER_BATCH_SIZE=50
CLUSTER_WINDOW_HOURS=72
CLUSTER_CANDIDATE_LIMIT=20
CLUSTER_THRESHOLD=0.75
CLUSTER_MERGE_THRESHOLD=0.85
# Default --interval for the deprecated news-service alias.
SERVICE_INTERVAL_SECONDS=1800

# How long a run may go without a heartbeat before a later run reaps it.
# The effective threshold is max(3 * --interval, this value).
WORKER_HEARTBEAT_TIMEOUT_SECONDS=900

# Airflow (deployments/docker-compose.airflow.yml). Only needed when running
# the orchestration stack; see docs/orchestration-airflow.md.
# Absolute path to this repo ON THE HOST: the scheduler bind-mounts
# $NEWS_RADAR_REPO/data into every worker container, and that path is resolved
# by the host's Docker daemon, not inside the scheduler.
NEWS_RADAR_REPO=
# Local fallback is news-radar-worker:dev. Deployments should use an immutable
# Git SHA tag or image digest, e.g. news-radar-worker:a1b2c3d.
NEWS_RADAR_WORKER_IMAGE=news-radar-worker:dev
NEWS_RADAR_DOCKER_NETWORK=news-radar_default
AIRFLOW_PORT=8080
AIRFLOW_UID=50000
# Group owning /var/run/docker.sock on the host; 999 on most Linux distros.
AIRFLOW_DOCKER_GID=999
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=

# FastAPI (news-api) settings.
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000
API_DEFAULT_WINDOW_DAYS=30
