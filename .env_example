# Required only for the Tavily search command.
TAVILY_API_KEY=

# Runtime logging.
LOG_LEVEL=INFO

# RSS/Atom pipeline/service defaults (.tsv or .opml).
RSS_FEED_PATH=
# Legacy fallback for existing Google News TSV deployments.
GOOGLE_NEWS_TSV_PATH=
MAX_FEEDS=0
MAX_ARTICLES_PER_FEED=20
MAX_CONCURRENT_CRAWLS=10
SERVICE_INTERVAL_SECONDS=1800
